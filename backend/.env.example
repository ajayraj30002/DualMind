# ─── LLM (Google Gemini / Groq) ───────────────
# Primary provider: Google Gemini (Get key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key

# Optional fallback provider: Groq (Get key at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key

# Optional model override (defaults to gemini-2.0-flash)
LLM_MODEL=gemini-2.0-flash

# ─── Search ──────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key

# ─── Reranking ───────────────────────────────
COHERE_API_KEY=your_cohere_api_key

# ─── Database (Supabase) ─────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ─── Authentication ──────────────────────────
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ─── CORS ────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500
